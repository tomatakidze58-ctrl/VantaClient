  "environment": "client",
  "icon": "assets/vantaclient/logo.png",
  "entrypoints": {
    "client": ["dev.vanta.client.VantaClient"]
  },
  "mixins": ["vantaclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
